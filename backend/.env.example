# Copy to backend/.env for local development. Never commit the real .env.

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-secret-in-production
# Session length. Changing your password signs out every other session.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (defaults to a local SQLite file - swap for Postgres if you want) ---
DATABASE_URL=sqlite:///./ai_job_assistant.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_job_assistant

# --- LLM provider: "ollama" (local) or "groq" (hosted) ---
LLM_PROVIDER=ollama

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Hosted LLM (Groq) - free key at https://console.groq.com/keys ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- CORS (comma-separated if more than one) ---
FRONTEND_ORIGIN=http://localhost:5173
# Base URL used in password-reset links (defaults to the first FRONTEND_ORIGIN)
# FRONTEND_URL=http://localhost:5173

# --- Email for password resets (optional - leave EMAIL_PROVIDER empty to disable) ---
# Option A: Brevo HTTP API (free, works on Render's free tier which blocks SMTP)
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=you@yourdomain.com        # must be a verified sender in Brevo
#
# Option B: any SMTP server (e.g. Gmail with an App Password)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=AI Job Search Assistant
# PASSWORD_RESET_TOKEN_MINUTES=30

# --- Limits ---
# MAX_UPLOAD_MB=5
# JOB_CACHE_MINUTES=360
