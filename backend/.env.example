# --- Auth ---
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (defaults to a local SQLite file - swap for Postgres if you want) ---
DATABASE_URL=sqlite:///./ai_job_assistant.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_job_assistant

# --- LLM provider: "ollama" (local) or "groq" (hosted) ---
LLM_PROVIDER=ollama

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Hosted LLM (Groq) - free key at https://console.groq.com/keys ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- CORS (comma-separated if more than one) ---
FRONTEND_ORIGIN=http://localhost:5173
